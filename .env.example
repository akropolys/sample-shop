# The shop's public https address (used when sending products to kiku).
BASE_URL=https://your-shop.example

# Your two kiku keys from Shell.
KIKU_PUBLIC_KEY=
KIKU_PRIVATE_KEY=""

# Only needed with keys made before late 2026, or until the SDK update is on npm.
KIKU_SITE_ID=
KIKU_PUBLIC_KEY_ID=

# Test checkout through Polar (every cart costs $1). Token scopes: checkouts:write, orders:read, refunds:write.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=2cd9687d-2afe-4886-b5b1-beca7ce1bbc3
# "sandbox" uses Polar's test mode (card 4242 4242 4242 4242, no real money). Leave empty for real payments.
POLAR_SERVER=
# true refunds each $1 test payment as soon as it is confirmed.
POLAR_AUTO_REFUND=true
